  <style>
    .suporte-popup {
      display: none;
      position: absolute;
      bottom: 70px;
      left: 0;
      z-index: 1000;
      width: 300px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.3);
      transition: all 0.3s ease;
    }

    .suporte-popup.ativo {
      display: block;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var botao = document.querySelector(".suporte-botao");
      var popup = document.querySelector(".suporte-popup");
      var fechar = document.querySelector(".suporte-close");

      if (botao && popup) {
        botao.addEventListener("click", function () {
          popup.classList.toggle("ativo");
        });
      }

      if (fechar) {
        fechar.addEventListener("click", function () {
          popup.classList.remove("ativo");
        });
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
