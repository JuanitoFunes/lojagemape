{%- if section.settings.mostrar_secao -%}
<style>
  /* === Botao WhatsApp Flutuante v3 === */
  @keyframes wpp-ring1 {
    0%   { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  @keyframes wpp-ring2 {
    0%   { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  @keyframes wpp-bounce {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.1); }
  }
  .wpp-flutuante {
    position: fixed !important;
    right: 20px !important;
    top: 90px !important;
    bottom: auto !important;
    left: auto !important;
    z-index: 99999 !important;
  }
  .wpp-wrapper {
    position: relative;
    width: 72px;
    height: 72px;
  }
  .wpp-wrapper::before,
  .wpp-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.45);
    animation: wpp-ring1 2s ease-out infinite;
    z-index: 0;
  }
  .wpp-wrapper::after {
    background: rgba(37, 211, 102, 0.3);
    animation: wpp-ring2 2s ease-out infinite 0.5s;
  }
  .wpp-btn {
    position: relative;
    z-index: 1;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(37,211,102,0.55);
    animation: wpp-bounce 2s ease-in-out infinite;
    transition: transform 0.2s, box-shadow 0.2s;
    border: none;
    outline: none;
  }
  .wpp-btn:hover {
    transform: scale(1.12) !important;
    box-shadow: 0 6px 28px rgba(37,211,102,0.75);
    animation-play-state: paused;
  }
  .wpp-btn svg {
    width: 44px;
    height: 44px;
    fill: #fff;
    display: block;
  }
  .wpp-popup {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 290px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.18);
    transform: scale(0.8) translateY(-10px);
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
    z-index: 2;
  }
  .wpp-popup.ativo {
    transform: scale(1) translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .wpp-popup-header {
    background: {{ section.settings.cor_background }};
    border-radius: 10px 10px 0 0;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    position: relative;
    color: #fff;
  }
  .wpp-popup-header svg {
    width: 28px; height: 28px; fill: #fff; flex-shrink: 0;
  }
  .wpp-popup-header-text {
    margin-left: 12px;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .wpp-popup-header-text strong { font-size: 14px; }
  .wpp-popup-header-text span   { font-size: 12px; opacity: 0.9; }
  .wpp-fechar {
    position: absolute;
    right: 10px; top: 10px;
    cursor: pointer; opacity: 0.8;
  }
  .wpp-fechar:hover { opacity: 1; }
  .wpp-fechar svg { width: 13px; height: 13px; fill: #fff; }
  .wpp-popup-body { padding: 14px; }
  .wpp-bloco:not(:last-child) {
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e8e8e8;
  }
  .wpp-bloco-titulo {
    display: flex; align-items: center; margin-bottom: 6px;
  }
  .wpp-bloco-titulo svg {
    width: 14px; height: 14px;
    fill: {{ section.settings.cor_background }};
    margin-right: 6px; flex-shrink: 0;
  }
  .wpp-bloco-titulo span { font-weight: 600; font-size: 13px; color: #333; }
  .wpp-bloco a {
    display: flex; align-items: center;
    margin-top: 5px; text-decoration: none; color: #333;
  }
  .wpp-bloco a span { font-size: 14px; }
  .wpp-bloco a strong {
    font-size: 11px; font-weight: 500;
    margin-left: 6px; padding: 1px 6px;
    border-radius: 3px;
    border: 2px solid {{ section.settings.cor_background }};
    color: {{ section.settings.cor_background }};
  }
  .wpp-bloco.ha span { display: block; font-size: 13px; color: #555; }
</style>

<div class="wpp-flutuante">
  <div class="wpp-wrapper">
    <div class="wpp-btn" id="wpp-abrir">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
        <path d="M16 1C7.716 1 1 7.716 1 16c0 2.628.68 5.1 1.872 7.253L1 31l7.957-2.087A14.94 14.94 0 0016 31c8.284 0 15-6.716 15-15S24.284 1 16 1zm0 27.273a12.22 12.22 0 01-6.232-1.706l-.447-.265-4.634 1.214 1.233-4.504-.29-.463A12.22 12.22 0 013.727 16C3.727 9.718 8.718 4.727 16 4.727S28.273 9.718 28.273 16 23.282 28.273 16 28.273zm6.71-9.146c-.365-.183-2.163-1.067-2.498-1.188-.335-.122-.58-.183-.824.183-.244.365-.944 1.188-1.158 1.432-.213.244-.427.274-.792.091-.365-.183-1.54-.567-2.934-1.81-1.085-.966-1.817-2.158-2.03-2.523-.213-.365-.023-.562.16-.744.164-.163.365-.427.548-.64.183-.213.244-.365.365-.609.122-.244.061-.457-.03-.64-.091-.183-.824-1.982-1.128-2.713-.298-.71-.6-.614-.824-.625h-.75c-.244 0-.64.092-.975.457-.335.366-1.28 1.25-1.28 3.048s1.31 3.535 1.493 3.779c.183.244 2.578 3.933 6.247 5.515.873.377 1.554.601 2.084.769.876.278 1.674.238 2.305.145.703-.103 2.163-.884 2.468-1.738.305-.854.305-1.586.213-1.738-.091-.152-.335-.244-.7-.427z"/>
      </svg>
    </div>

    <div class="wpp-popup" id="wpp-popup">
      <div class="wpp-popup-header">
        <div class="wpp-fechar" id="wpp-fechar">
          <svg viewBox="0 0 492 492" xmlns="http://www.w3.org/2000/svg">
            <path d="M300.19 246l183.95-183.96c10.5-10.496 10.5-27.568 0-38.052l-16.12-16.116c-10.496-10.496-27.568-10.496-38.064 0L246 191.776 62.044 7.876C51.548-2.62 34.476-2.62 23.98 7.876L7.852 23.992C-2.644 34.488-2.644 51.56 7.852 62.044L191.808 246 7.852 429.956c-10.496 10.496-10.496 27.568 0 38.052l16.128 16.116c10.496 10.072 27.568 10.072 38.064 0L246 300.224l183.956 183.9c10.496 10.072 27.568 10.072 38.064 0l16.12-16.116c10.496-10.484 10.496-27.556 0-38.052L300.19 246z"/>
          </svg>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
          <path d="M16 1C7.716 1 1 7.716 1 16c0 2.628.68 5.1 1.872 7.253L1 31l7.957-2.087A14.94 14.94 0 0016 31c8.284 0 15-6.716 15-15S24.284 1 16 1zm0 27.273a12.22 12.22 0 01-6.232-1.706l-.447-.265-4.634 1.214 1.233-4.504-.29-.463A12.22 12.22 0 013.727 16C3.727 9.718 8.718 4.727 16 4.727S28.273 9.718 28.273 16 23.282 28.273 16 28.273zm6.71-9.146c-.365-.183-2.163-1.067-2.498-1.188-.335-.122-.58-.183-.824.183-.244.365-.944 1.188-1.158 1.432-.213.244-.427.274-.792.091-.365-.183-1.54-.567-2.934-1.81-1.085-.966-1.817-2.158-2.03-2.523-.213-.365-.023-.562.16-.744.164-.163.365-.427.548-.64.183-.213.244-.365.365-.609.122-.244.061-.457-.03-.64-.091-.183-.824-1.982-1.128-2.713-.298-.71-.6-.614-.824-.625h-.75c-.244 0-.64.092-.975.457-.335.366-1.28 1.25-1.28 3.048s1.31 3.535 1.493 3.779c.183.244 2.578 3.933 6.247 5.515.873.377 1.554.601 2.084.769.876.278 1.674.238 2.305.145.703-.103 2.163-.884 2.468-1.738.305-.854.305-1.586.213-1.738-.091-.152-.335-.244-.7-.427z"/>
        </svg>
        <div class="wpp-popup-header-text">
          <strong>Precisa de ajuda?</strong>
          <span>Fale com um de nossos atendentes</span>
        </div>
      </div>

      <div class="wpp-popup-body">
        {%- if section.blocks.size > 0 -%}
          {%- assign lista_telefone = section.blocks | where: 'type', 'telefone' -%}
          {%- assign lista_whatsapp = section.blocks | where: 'type', 'whatsapp' -%}
          {%- assign lista_email    = section.blocks | where: 'type', 'email' -%}
          {%- assign lista_horario  = section.blocks | where: 'type', 'horario_atendimento' -%}

          {%- if lista_telefone.size > 0 -%}
            <div class="wpp-bloco">
              <div class="wpp-bloco-titulo">
                <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="m379.18 287.94c-19.219 19.242-49.238 49.293-74.375 74.605-29.879-19.559-56.887-41.141-78.605-62.859-26.82-26.82-60.359-65.008-78.484-92.059 23.012-22.848 53.105-52.902 75.188-74.965l-132.66-132.66-66.191 65-0.097657 0.097656c-18.523 18.523-26.367 43.809-23.312 75.152 9.7695 100.23 132.33 245.4 240.68 318.11 62.727 42.098 152.89 81.066 206.21 27.734 38.719-38.715 53.52-54.488 54.133-55.141l9.9297-10.602zm47.125 176.93c-40.371 40.367-120.43 0.66016-168.26-31.438-100.54-67.477-218.71-205.67-227.52-296.1-2.1406-21.945 2.7773-39.094 14.613-50.961l44.918-44.109 90.379 90.383c-45.836 45.766-59.645 59.406-70.625 70.277l5.8242 10.039c17.688 30.469 58.711 77.316 89.344 107.95 33.602 33.602 68.094 57.324 104.16 79.898l8.4492-8.5273c18.539-18.707 45.48-45.719 61.609-61.875l90.504 90.504c-8.3828 8.6523-22.387 22.949-43.391 43.957z"/></svg>
                <span>Telefone:</span>
              </div>
              {%- for t in lista_telefone -%}
                <a href="tel:{{ t.settings.ddi }}{{ t.settings.numero }}" target="_blank">
                  <span>{{ t.settings.numero }}</span><strong>{{ t.settings.regiao }}</strong>
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if lista_whatsapp.size > 0 -%}
            <div class="wpp-bloco">
              <div class="wpp-bloco-titulo">
                <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="M16 1C7.716 1 1 7.716 1 16c0 2.628.68 5.1 1.872 7.253L1 31l7.957-2.087A14.94 14.94 0 0016 31c8.284 0 15-6.716 15-15S24.284 1 16 1zm6.71 18.127c-.365-.183-2.163-1.067-2.498-1.188-.335-.122-.58-.183-.824.183-.244.365-.944 1.188-1.158 1.432-.213.244-.427.274-.792.091-.365-.183-1.54-.567-2.934-1.81-1.085-.966-1.817-2.158-2.03-2.523-.213-.365-.023-.562.16-.744.164-.163.365-.427.548-.64.183-.213.244-.365.365-.609.122-.244.061-.457-.03-.64-.091-.183-.824-1.982-1.128-2.713-.298-.71-.6-.614-.824-.625h-.701c-.244 0-.64.092-.975.457-.335.366-1.28 1.25-1.28 3.048s1.31 3.535 1.493 3.779c.183.244 2.578 3.933 6.247 5.515.873.377 1.554.601 2.084.769.876.278 1.674.238 2.305.145.703-.103 2.163-.884 2.468-1.738.305-.854.305-1.586.213-1.738-.091-.152-.335-.244-.7-.427z"/></svg>
                <span>WhatsApp:</span>
              </div>
              {%- for w in lista_whatsapp -%}
                <a href="https://wa.me/{{ w.settings.ddi }}{{ w.settings.numero | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}?text={{ w.settings.texto }}{% if w.settings.enviar_link_produto %} > Link:%20{{ shop.url }}{{ product.url }}{% endif %}" target="_blank">
                  <span>{{ w.settings.numero }}</span><strong>{{ w.settings.nome_atendente }}</strong>
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if lista_email.size > 0 -%}
            <div class="wpp-bloco">
              <div class="wpp-bloco-titulo">
                <svg viewBox="0 0 479.058 479.058" xmlns="http://www.w3.org/2000/svg"><path d="m434.15 59.882h-389.23c-24.766 0-44.912 20.146-44.912 44.912v269.47c0 24.766 20.146 44.912 44.912 44.912h389.23c24.766 0 44.912-20.146 44.912-44.912v-269.47c0-24.766-20.146-44.912-44.912-44.912zm0 29.941c2.034 0 3.969 0.422 5.738 1.159l-200.36 173.65-200.36-173.65c1.769-0.736 3.704-1.159 5.738-1.159zm0 299.41h-389.23c-8.26 0-14.971-6.71-14.971-14.971v-251.65l199.78 173.14c2.822 2.441 6.316 3.655 9.81 3.655s6.988-1.213 9.81-3.655l199.78-173.14v251.65c-1e-3 8.26-6.711 14.97-14.971 14.97z"/></svg>
                <span>E-mail:</span>
              </div>
              {%- for e in lista_email -%}
                <a href="mailto:{{ e.settings.email }}" target="_blank">
                  <span>{{ e.settings.email }}</span>
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if lista_horario.size > 0 -%}
            <div class="wpp-bloco ha">
              <div class="wpp-bloco-titulo">
                <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm61.8-104.4l-84.9-61.7c-3.1-2.3-4.9-5.9-4.9-9.7V116c0-6.6 5.4-12 12-12h32c6.6 0 12 5.4 12 12v141.7l66.8 48.6c5.4 3.9 6.5 11.4 2.6 16.8L334.6 349c-3.9 5.3-11.4 6.5-16.8 2.6z"/></svg>
                <span>Horario:</span>
              </div>
              {%- for h in lista_horario -%}{{ h.settings.descricao }}{%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var btn    = document.getElementById('wpp-abrir');
    var popup  = document.getElementById('wpp-popup');
    var fechar = document.getElementById('wpp-fechar');
    if (!btn || !popup) return;
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      popup.classList.toggle('ativo');
    });
    if (fechar) {
      fechar.addEventListener('click', function(e) {
        e.stopPropagation();
        popup.classList.remove('ativo');
      });
    }
    document.addEventListener('click', function(e) {
      if (!popup.contains(e.target) && e.target !== btn) {
        popup.classList.remove('ativo');
      }
    });
  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Botao de suporte",
  "class": "overflow-hidden",
  "settings": [
    {
      "type": "checkbox",
      "id": "mostrar_secao",
      "label": "Mostrar botao de suporte",
      "default": true
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "cor_background",
      "label": "Cor do background",
      "default": "#25d366"
    }
  ],
  "blocks": [
    {
      "type": "telefone",
      "name": "Telefone",
      "settings": [
        { "type": "text", "id": "ddi",    "label": "DDI",    "default": "55" },
        { "type": "text", "id": "numero", "label": "Numero", "default": "4004-2022" },
        { "type": "text", "id": "regiao", "label": "Regiao", "default": "Capitais" }
      ]
    },
    {
      "type": "whatsapp",
      "name": "Whatsapp",
      "settings": [
        { "type": "text",     "id": "ddi",                 "label": "DDI",                    "default": "55" },
        { "type": "text",     "id": "numero",              "label": "Numero",                 "default": "(11) 99999-9999" },
        { "type": "text",     "id": "texto",               "label": "Mensagem inicial",       "default": "Ola vim da sua loja!" },
        { "type": "checkbox", "id": "enviar_link_produto", "label": "Enviar link do produto", "default": true },
        { "type": "text",     "id": "nome_atendente",      "label": "Nome do atendente",      "default": "Atendente" }
      ]
    },
    {
      "type": "email",
      "name": "E-mail",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "email", "label": "E-mail", "default": "contato@sualoja.com" }
      ]
    },
    {
      "type": "horario_atendimento",
      "name": "Horario de atendimento",
      "limit": 1,
      "settings": [
        { "type": "html", "id": "descricao", "label": "Descricao", "default": "<span>Seg a Sex das 9h as 18h</span>" }
      ]
    }
  ]
}
{% endschema %}