  <div class="suporte-flutuante central-botao lado-direito" style="right: 20px; top: 80px; left: auto; bottom: auto;">
    <style>
  /* Anel pulsante duplo */
  @keyframes suporte-pulse-ring1 {
    0%   { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  @keyframes suporte-pulse-ring2 {
    0%   { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @keyframes suporte-bounce {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.12); }
  }

  .suporte-botao-wrapper {
    position: relative;
    width: 72px;
    height: 72px;
  }

  /* anéis pulsantes */
  .suporte-botao-wrapper::before,
  .suporte-botao-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.5);
    animation: suporte-pulse-ring1 2s ease-out infinite;
    z-index: 0;
  }
  .suporte-botao-wrapper::after {
    background: rgba(37, 211, 102, 0.35);
    animation: suporte-pulse-ring2 2s ease-out infinite 0.4s;
  }

  .suporte-botao {
    position: relative;
    z-index: 1;
    animation: suporte-bounce 2s ease-in-out infinite;
    border-radius: 50%;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #25d366;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(37,211,102,0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .suporte-botao:hover {
    transform: scale(1.1) !important;
    box-shadow: 0 6px 24px rgba(37,211,102,0.7);
    animation-play-state: paused;
  }
  .suporte-botao svg {
    width: 42px;
    height: 42px;
    fill: #fff;
  }
</style>

    <div class="suporte-botao-wrapper">
