{%- liquid
  assign ativar = section.settings.ativar_widget
  assign mostrar_desktop = section.settings.mostrar_desktop
  assign mostrar_celular = section.settings.mostrar_celular
  assign ddi = section.settings.ddi | default: '55'
  assign numero_raw = section.settings.numero_whatsapp | default: ''
  assign numero_limpo = numero_raw | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign mensagem = section.settings.mensagem_automatica | default: 'Olá! Vim da loja e quero informações.' | url_encode
  assign url_whatsapp = ''
  if numero_limpo != blank
    assign url_whatsapp = 'https://wa.me/' | append: ddi | append: numero_limpo
    if mensagem != blank
      assign url_whatsapp = url_whatsapp | append: '?text=' | append: mensagem
    endif
  endif
  assign pos_h = section.settings.posicao_horizontal | default: 'direita'
  assign pos_v = section.settings.posicao_vertical | default: 'inferior'
  assign distancia = section.settings.distancia_bordas | default: 24
  assign tam_imagem = section.settings.tamanho_imagem | default: 72
  assign tam_icone = section.settings.tamanho_icone_whatsapp | default: 28
  assign tam_widget = section.settings.tamanho_widget | default: 'medio'
  assign animar = section.settings.ativar_animacao
  assign abrir_nova_aba = section.settings.abrir_nova_aba
  assign cor_fundo = section.settings.cor_fundo | default: '#ffffff'
  assign cor_texto = section.settings.cor_texto | default: '#1f2937'
  assign cor_botao = section.settings.cor_botao | default: '#25d366'
  assign cor_botao_texto = '#ffffff'
-%}

{%- if ativar -%}
<style>
  #shopify-section-whatsapp-vendedor,
  .shopify-section:has(.wv-wrapper) {
    overflow: visible !important;
    transform: none !important;
    filter: none !important;
    contain: none !important;
    position: static !important;
  }

  @keyframes wv-icon-pulse {
    0%   { transform: scale(1);    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35), 0 0 0 0 rgba(37, 211, 102, 0.45); }
    55%  { transform: scale(1.12); box-shadow: 0 8px 26px rgba(37, 211, 102, 0.55), 0 0 0 12px rgba(37, 211, 102, 0); }
    100% { transform: scale(1);    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35), 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  @keyframes wv-slide-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .wv-wrapper {
    --wv-distance: {{ distancia }}px;
    --wv-img-size: {{ tam_imagem }}px;
    --wv-icon-size: {{ tam_icone }}px;
    position: fixed !important;
    z-index: 2147483645 !important;
    {% if pos_v == 'inferior' %}bottom: var(--wv-distance);{% else %}top: var(--wv-distance);{% endif %}
    {% if pos_h == 'direita' %}right: var(--wv-distance);{% else %}left: var(--wv-distance);{% endif %}
    {% unless mostrar_desktop %}display: none !important;{% endunless %}
    max-width: 340px;
    width: calc(100% - (var(--wv-distance) * 2));
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    animation: wv-slide-in 0.35s ease-out both;
  }
  .wv-card {
    display: flex;
    align-items: stretch;
    background: {{ cor_fundo }};
    border-radius: 20px;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.18), 0 4px 12px rgba(15, 23, 42, 0.10);
    overflow: visible;
    border: 1px solid rgba(15, 23, 42, 0.06);
    text-decoration: none !important;
    color: {{ cor_texto }};
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    will-change: transform;
    padding: 10px 14px 10px 10px;
  }
  .wv-card:focus-visible {
    outline: 3px solid {{ cor_botao }};
    outline-offset: 2px;
  }
  .wv-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 46px rgba(15, 23, 42, 0.22), 0 6px 18px rgba(15, 23, 42, 0.12);
  }
  .wv-photo-wrap {
    position: relative;
    flex-shrink: 0;
    width: var(--wv-img-size);
    height: var(--wv-img-size);
    align-self: center;
  }
  .wv-photo {
    width: var(--wv-img-size);
    height: var(--wv-img-size);
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 2px solid rgba(15, 23, 42, 0.08);
    background: #f3f4f6;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.10);
  }
  .wv-photo-initials {
    width: var(--wv-img-size);
    height: var(--wv-img-size);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 700;
    font-size: calc(var(--wv-img-size) / 3);
    background: linear-gradient(135deg, #6b7280 0%, #374151 100%);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.10);
  }
  .wv-wa-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: var(--wv-icon-size);
    height: var(--wv-icon-size);
    min-width: 22px;
    min-height: 22px;
    border-radius: 50%;
    background: {{ cor_botao }};
    color: {{ cor_botao_texto }};
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45), 0 0 0 2px {{ cor_fundo }};
    z-index: 2;
    {% if animar %}animation: wv-icon-pulse 1.8s ease-in-out infinite;{% endif %}
  }
  .wv-wa-badge svg {
    width: 62%;
    height: 62%;
    fill: currentColor;
    display: block;
  }
  .wv-body {
    padding: 2px 6px 2px 12px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .wv-title {
    margin: 0 0 2px 0;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
    color: {{ cor_texto }};
  }
  .wv-cta {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.35;
    color: {{ cor_texto }};
    opacity: 0.82;
  }
  .wv-nome-vendedor {
    display: block;
    margin-top: 4px;
    font-size: 11.5px;
    color: {{ cor_botao }};
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wv-card.size--pequeno {
    --wv-img-size: calc(var(--wv-img-size) - 8px);
    --wv-icon-size: calc(var(--wv-icon-size) - 4px);
    padding: 8px 12px 8px 8px;
    border-radius: 16px;
  }
  .wv-card.size--pequeno .wv-title { font-size: 13.5px; }
  .wv-card.size--pequeno .wv-cta  { font-size: 11.5px; }
  .wv-card.size--grande  {
    --wv-img-size: calc(var(--wv-img-size) + 20px);
    --wv-icon-size: calc(var(--wv-icon-size) + 8px);
    padding: 14px 18px 14px 14px;
    border-radius: 24px;
  }
  .wv-card.size--grande .wv-title { font-size: 17px; }
  .wv-card.size--grande .wv-cta  { font-size: 13.5px; }
  .wv-card.size--grande .wv-body { padding: 4px 6px 4px 16px; }

  @media (max-width: 749px) {
    {% unless mostrar_celular %}
    .wv-wrapper { display: none !important; }
    {% endunless %}
    .wv-wrapper {
      max-width: 260px;
    }
    .wv-card { border-radius: 18px; padding: 8px 10px 8px 8px; }
    .wv-title  { font-size: 13.5px; }
    .wv-cta  { font-size: 11.5px; }
    .wv-body { padding: 2px 4px 2px 10px; }
    .wv-photo-wrap { padding: 0; }
  }
  @media (min-width: 750px) {
    .wv-card.size--pequeno { --wv-img-size: calc(var(--wv-img-size) - 8px); --wv-icon-size: calc(var(--wv-icon-size) - 4px); }
    .wv-card.size--grande  { --wv-img-size: calc(var(--wv-img-size) + 20px); --wv-icon-size: calc(var(--wv-icon-size) + 8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wv-wrapper, .wv-wa-badge { animation: none !important; }
    .wv-card:hover { transform: none !important; }
  }
</style>

<div class="wv-wrapper" id="wv-wrapper-{{ section.id }}" role="region" aria-label="Atendimento via WhatsApp">
  <a
    class="wv-card size--{{ tam_widget }}"
    href="{{ url_whatsapp }}"
    {% if abrir_nova_aba %}target="_blank" rel="noopener noreferrer"{% endif %}
    aria-label="{% if section.settings.nome_vendedor != blank %}{{ section.settings.nome_vendedor }} - {% endif %}{% if section.settings.texto_principal != blank %}{{ section.settings.texto_principal }} - {% endif %}Atendimento via WhatsApp{% if section.settings.texto_secundario != blank %} - {{ section.settings.texto_secundario }}{% endif %}"
    data-wv-card
  >
    <div class="wv-photo-wrap">
      {%- if section.settings.foto_vendedor != blank -%}
        <img
          class="wv-photo"
          src="{{ section.settings.foto_vendedor | image_url: width: 240 }}"
          alt="{% if section.settings.nome_vendedor != blank %}Foto de {{ section.settings.nome_vendedor }}{% else %}Foto do vendedor{% endif %}"
          width="{{ tam_imagem }}"
          height="{{ tam_imagem }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          class="wv-photo"
          src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Professional%20friendly%20female%20customer%20support%20agent%20with%20silver%20white%20headset%20microphone%2C%20medium%20dark%20brown%20straight%20bob%20hair%2C%20warm%20smile%20showing%20teeth%2C%20wearing%20light%20sky%20blue%20button%20up%20collared%20shirt%2C%20soft%20neutral%20plain%20light%20gray%20studio%20background%2C%20high%20resolution%20square%20photorealistic%20headshot%20portrait%2C%20business%20professional%20attire&image_size=square_hd"
          alt="{% if section.settings.nome_vendedor != blank %}Foto de {{ section.settings.nome_vendedor }}{% else %}Foto do vendedor{% endif %}"
          width="{{ tam_imagem }}"
          height="{{ tam_imagem }}"
          loading="lazy"
        >
      {%- endif -%}
      <span class="wv-wa-badge" aria-hidden="true">
        <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 1C7.716 1 1 7.716 1 16c0 2.628.68 5.1 1.872 7.253L1 31l7.957-2.087A14.94 14.94 0 0016 31c8.284 0 15-6.716 15-15S24.284 1 16 1zm6.71 18.127c-.365-.183-2.163-1.067-2.498-1.188-.335-.122-.58-.183-.824.183-.244.365-.944 1.188-1.158 1.432-.213.244-.427.274-.792.091-.365-.183-1.54-.567-2.934-1.81-1.085-.966-1.817-2.158-2.03-2.523-.213-.365-.023-.562.16-.744.164-.163.365-.427.548-.64.183-.213.244-.365.365-.609.122-.244.061-.457-.03-.64-.091-.183-.824-1.982-1.128-2.713-.298-.71-.6-.614-.824-.625h-.701c-.244 0-.64.092-.975.457-.335.366-1.28 1.25-1.28 3.048s1.31 3.535 1.493 3.779c.183.244 2.578 3.933 6.247 5.515.873.377 1.554.601 2.084.769.876.278 1.674.238 2.305.145.703-.103 2.163-.884 2.468-1.738.305-.854.305-1.586.213-1.738-.091-.152-.335-.244-.7-.427z"/>
        </svg>
      </span>
    </div>

    <div class="wv-body">
      {%- if section.settings.texto_principal != blank -%}
        <p class="wv-title">{{ section.settings.texto_principal }}</p>
      {%- endif -%}
      {%- if section.settings.texto_secundario != blank -%}
        <p class="wv-cta">{{ section.settings.texto_secundario }}</p>
      {%- endif -%}
      {%- if section.settings.nome_vendedor != blank -%}
        <span class="wv-nome-vendedor">{{ section.settings.nome_vendedor }}</span>
      {%- endif -%}
    </div>
  </a>
</div>

<script>
  (function () {
    var card = document.querySelector('[data-wv-card]');
    if (!card) return;
    var closeKey = 'wv-closed-' + {{ section.id | json }};
    var SEVEN_DAYS = 1000 * 60 * 60 * 24 * 7;
    try {
      var closedAt = parseInt(localStorage.getItem(closeKey) || '0', 10);
      if (closedAt && (Date.now() - closedAt) < SEVEN_DAYS) {
        var wrap = document.getElementById('wv-wrapper-{{ section.id }}');
        if (wrap) wrap.style.display = 'none';
      }
    } catch (e) {}
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        var href = card.getAttribute('href');
        if (href && href.indexOf('wa.me') !== -1) {
          e.preventDefault();
          {% if abrir_nova_aba %}window.open(href, '_blank', 'noopener,noreferrer');{% else %}window.location.href = href;{% endif %}
        }
      }
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp Vendedor",
  "tag": "section",
  "class": "whatsapp-vendedor-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "ativar_widget",
      "label": "Ativar widget de vendedor",
      "default": true,
      "info": "Exibe o botão flutuante integrado de atendimento comercial"
    },
    {
      "type": "header",
      "content": "Dados do vendedor"
    },
    {
      "type": "image_picker",
      "id": "foto_vendedor",
      "label": "Foto do vendedor",
      "info": "Recomendado: 240x240px, formato JPG quadrado"
    },
    {
      "type": "text",
      "id": "nome_vendedor",
      "label": "Nome do vendedor",
      "placeholder": "Ex.: Maria - Vendas"
    },
    {
      "type": "header",
      "content": "Textos de chamada"
    },
    {
      "type": "text",
      "id": "texto_principal",
      "label": "Texto principal",
      "default": "Fale com nosso vendedor",
      "placeholder": "Título visível no card"
    },
    {
      "type": "textarea",
      "id": "texto_secundario",
      "label": "Texto secundário (subtítulo)",
      "default": "Atendimento pelo WhatsApp",
      "placeholder": "Ex.: Tire suas dúvidas em minutos"
    },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    {
      "type": "text",
      "id": "ddi",
      "label": "DDI do país",
      "default": "55",
      "info": "Brasil = 55"
    },
    {
      "type": "text",
      "id": "numero_whatsapp",
      "label": "Número do WhatsApp com DDD",
      "default": "(11) 99999-9999",
      "placeholder": "(11) 99999-9999",
      "info": "O número é limpo automaticamente (remove parênteses, espaços e traços)"
    },
    {
      "type": "textarea",
      "id": "mensagem_automatica",
      "label": "Mensagem inicial automática",
      "default": "Olá! Vim da loja e quero informações.",
      "placeholder": "Mensagem enviada ao abrir a conversa"
    },
    {
      "type": "checkbox",
      "id": "abrir_nova_aba",
      "label": "Abrir WhatsApp em nova aba",
      "default": true
    },
    {
      "type": "header",
      "content": "Posição e tamanho"
    },
    {
      "type": "select",
      "id": "posicao_horizontal",
      "label": "Posição horizontal",
      "default": "direita",
      "options": [
        { "value": "esquerda", "label": "Esquerda" },
        { "value": "direita",  "label": "Direita" }
      ]
    },
    {
      "type": "select",
      "id": "posicao_vertical",
      "label": "Posição vertical",
      "default": "inferior",
      "options": [
        { "value": "superior", "label": "Superior" },
        { "value": "inferior", "label": "Inferior" }
      ],
      "info": "Inferior direito é o padrão recomendado para atendimento"
    },
    {
      "type": "range",
      "id": "distancia_bordas",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Distância das bordas",
      "default": 24
    },
    {
      "type": "range",
      "id": "tamanho_imagem",
      "min": 48,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Tamanho da foto",
      "default": 72,
      "info": "Foto circular do vendedor (elemento principal)"
    },
    {
      "type": "range",
      "id": "tamanho_icone_whatsapp",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Tamanho do ícone do WhatsApp",
      "default": 28,
      "info": "Ícone sobreposto no canto inferior direito da foto"
    },
    {
      "type": "select",
      "id": "tamanho_widget",
      "label": "Tamanho geral do widget",
      "default": "medio",
      "options": [
        { "value": "pequeno", "label": "Pequeno" },
        { "value": "medio",   "label": "Médio" },
        { "value": "grande",  "label": "Grande" }
      ]
    },
    {
      "type": "header",
      "content": "Visibilidade"
    },
    {
      "type": "checkbox",
      "id": "mostrar_desktop",
      "label": "Mostrar no desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_celular",
      "label": "Mostrar no celular",
      "default": true
    },
    {
      "type": "header",
      "content": "Design e animação"
    },
    {
      "type": "checkbox",
      "id": "ativar_animacao",
      "label": "Ativar animação discreta (pulsar)",
      "default": true,
      "info": "Pulsa levemente apenas no ícone do WhatsApp sobreposto à foto"
    },
    {
      "type": "color",
      "id": "cor_fundo",
      "label": "Cor de fundo do card",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cor_texto",
      "label": "Cor dos textos",
      "default": "#1f2937"
    },
    {
      "type": "color",
      "id": "cor_botao",
      "label": "Cor do ícone do WhatsApp",
      "default": "#25d366"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp Vendedor",
      "category": "Atendimento"
    }
  ]
}
{% endschema %}
