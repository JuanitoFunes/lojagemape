{%- if section.settings.mostrar_secao -%}
    <style>
        #barra-newsletter {
            background: {{ section.settings.cor_background }};
        }

        #barra-newsletter .newsletter-assinar {
            background: {{ section.settings.cor_botao }};
            color: {{ section.settings.cor_texto_botao }};
        }

        #barra-newsletter .newsletter .newsletter-titulo svg path {
            fill: {{ section.settings.cor_icone }};
        }
    </style>

    <section id="barra-newsletter" class="posicao-rodape" data-section-id="{{ section.id }}" data-section-settings="{{ section_settings }}">
        <div class="conteiner">
            <div class="row-fluid">
                <div class="componente newsletter">
                    <div class="newsletter-titulo">
                        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path d="m87 24h-62c-4.4 0-8 3.6-8 8v3c0 1.1.9 2 2 2s2-.9 2-2v-3c0-.4.1-.8.2-1.2l22.4 19.2-22.4 19.2c-.1-.4-.2-.8-.2-1.2v-3c0-1.1-.9-2-2-2s-2 .9-2 2v3c0 4.4 3.6 8 8 8h62c4.4 0 8-3.6 8-8v-36c0-4.4-3.6-8-8-8zm-62.8 4.1c.2-.1.5-.1.8-.1h62c.3 0 .6 0 .8.1l-30.5 26.1c-.8.6-1.8.6-2.6 0zm62.8 43.9h-62c-.3 0-.6 0-.8-.1l22.5-19.3 5.4 4.7c1.1 1 2.5 1.5 3.9 1.5s2.8-.5 3.9-1.5l5.4-4.7 22.5 19.3c-.2.1-.5.1-.8.1zm4-4c0 .4-.1.8-.2 1.2l-22.4-19.2 22.4-19.2c.1.4.2.8.2 1.2zm-80-23c0-1.1.9-2 2-2h12c1.1 0 2 .9 2 2s-.9 2-2 2h-12c-1.1 0-2-.9-2-2zm14 12h-18c-1.1 0-2-.9-2-2s.9-2 2-2h18c1.1 0 2 .9 2 2s-.9 2-2 2z"/></svg>
                        <span class="titulo">
                            {{ section.settings.descricao }}
                        </span>
                    </div>
                    <div class="interno-conteudo">

                        {%- assign newsletter_id = 'newsletter-' | append: section.id -%}

                        {%- form 'customer', id: newsletter_id, class: 'form newsletter-cadastro input-conteiner' -%}
                            {%- if form.posted_successfully? -%}
                                <p class="alert alert--success">{{ 'footer.newsletter.success' | t }}</p>
                            {%- else -%}
                                {%- if form.errors -%}
                                    <p class="alert alert--error">{{ form.errors.messages['email'] }}</p>
                                {%- endif -%}

                                <input type="hidden" name="contact[tags]" value="newsletter">

                                <input type="email" id="newsletter[{{ section.id }}][contact][email]" name="contact[email]" class="form__field form__field--text" placeholder="Digite seu e-mail" required>
                                <button type="submit" class="botao botao-input newsletter-assinar" aria-label="{{ section.settings.texto_botao }}">{{ section.settings.texto_botao }}</button>
                            {%- endif -%}
                        {%- endform -%}
                    </div>
                </div>
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter",
  "class": "overflow-hidden",
  "settings": [
        {
          "type": "checkbox",
          "id": "mostrar_secao",
          "label": "Mostrar newsletter",
          "default": true
        },
        {
          "type": "color",
          "id": "cor_background",
          "label": "Cor do background",
          "default": "#2C2438"
        },
        {
          "type": "color",
          "id": "cor_botao",
          "label": "Cor do botão",
          "default": "#45EC7F"
        },
        {
          "type": "color",
          "id": "cor_texto_botao",
          "label": "Cor do texto do botão",
          "default": "#2C2438"
        },
        {
          "type": "color",
          "id": "cor_icone",
          "label": "Cor do icone",
          "default": "#45EC7F"
        },
        {
          "type": "text",
          "id": "texto_botao",
          "label": "Texto do botão",
          "default": "Cadastrar"
        },
        {
          "type": "textarea",
          "id": "descricao",
          "label": "Descrição",
          "default": "Ganhe 10% de desconto na sua primeira compra!"
        }
    ]
}
{% endschema %}