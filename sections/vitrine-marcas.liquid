<section id="vitrine-marcas" data-section-id="{{ section.id }}" data-section-settings="{{ section_settings }}">
    <div class="container">
        <div class="row-fluid">
          {% if section.settings.titulo %}
            <header class="section__header">
              <div class="section__header-stack">
                <h2 class="section__title heading h3">{{ section.settings.titulo }}</h2>
              </div>
            </header>
          {% endif %}

          <div class="marcas slick-slider" data-flickity>
            {% for block in section.blocks %}
                <li class="marca">
                      {% if block.settings.imagem != blank %}
                        {%- capture tamanho_imagem -%}{{ section.settings.tamanho_imagem }}x{%- endcapture -%}
                        <img class="marca-imagem" style="max-width: {{ section.settings.tamanho_imagem }}px;" src="{{ block.settings.imagem | img_url: tamanho_imagem }}" width="{{ block.settings.imagem.width }}" height="{{ block.settings.imagem.height }}" onclick="location.href = '{{ block.settings.link }}';">
                      {% elsif block.settings.imagem_svg != blank %}
                        <a href="{{ block.settings.link }}">
                          {{ block.settings.imagem_svg }}
                        </a>
                      {% endif %}
                </li>
            {% endfor %}
            </div>
        </div>
    </div>
</section>

<style>
  #vitrine-marcas {
    margin-top: {{ section.settings.margem_superior }}px;
    margin-bottom: {{ section.settings.margem_inferior }}px;
    background: {{ section.settings.cor_background }};
  }

  #vitrine-marcas .marcas .marca svg {
    max-width: {{ section.settings.tamanho_imagem }}px;
    cursor: pointer;
    height: auto;
    max-height: 100px;
    fill: #000000 !important;
  }

  #vitrine-marcas .marca-imagem {
    max-width: {{ section.settings.tamanho_imagem }}px;
    cursor: pointer;
    height: auto;
    max-height: 100px;
  }
</style>

